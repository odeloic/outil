{
  "name": "@odeloic/review",
  "version": "0.4.0",
  "description": "Agentic coding review tool.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odeloic/outil.git"
  },
  "homepage": "https://github.com/odeloic/outil#readme",
  "bugs": {
    "url": "https://github.com/odeloic/outil/issues"
  },
  "keywords": [
    "cli",
    "code-review",
    "agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "outil": "bin/outil.cjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "agents:sync": "node scripts/agents-sync.mjs",
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && vite build --ssr src/server/cli.ts --outDir dist/server",
    "prepack": "pnpm build",
    "lint": "eslint .",
    "start": "node bin/outil.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/codicons": "^0.0.46-24",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
